# Copy this file to .env and fill in your credentials.

# Required — Claude API key for photo analysis, item identification, and pricing
ANTHROPIC_API_KEY=sk-ant-...

# Kleinanzeigen.de credentials (used by the Playwright automation)
KLEINANZEIGEN_EMAIL=your@email.de
KLEINANZEIGEN_PASSWORD=yourpassword

# eBay Developer credentials
# Get them at https://developer.ebay.com/
EBAY_APP_ID=YourApp-...
EBAY_AUTH_TOKEN=v^1.1#i^1#f^0#...

# Set to true to use the eBay sandbox environment for testing
EBAY_SANDBOX=false
